{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vistasecurity.io/agents/managed/v1/defs/host-crypto-report.json",
  "title": "Host crypto report",
  "description": "One host crypto collection (shared/hostcrypto Report, field for field; docs/host-crypto.md). Posture, never key material: no field holds a private key, a passphrase, a keystore password or a shared secret. Every section is three-valued and more: read sections before treating an empty list as an answer. Closed: a field this schema does not name is an error, and observations_test.go fails when report.go and this schema disagree.",
  "type": "object",
  "required": ["collected", "mode", "platform", "access", "scope", "ssh", "sections"],
  "additionalProperties": false,
  "properties": {
    "collected": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["local", "remote"] },
    "platform": {
      "type": "string",
      "description": "linux, darwin or windows; empty or another word only on a report whose platform section failed."
    },
    "agent_id": { "type": "string" },
    "access": { "$ref": "#/$defs/access" },
    "scope": { "$ref": "#/$defs/scope" },
    "certificates": { "type": "array", "items": { "$ref": "#/$defs/certificate" } },
    "private_keys": { "type": "array", "items": { "$ref": "#/$defs/private_key" } },
    "keystores": { "type": "array", "items": { "$ref": "#/$defs/keystore" } },
    "ssh": { "$ref": "#/$defs/ssh" },
    "configs": { "type": "array", "items": { "$ref": "#/$defs/crypto_config" } },
    "libraries": { "type": "array", "items": { "$ref": "#/$defs/crypto_library" } },
    "protection": { "$ref": "#/$defs/protection" },
    "sections": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "enum": ["ok", "partial", "failed", "unsupported", "skipped"] }
    },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/step_error" } },
    "limits": { "type": "array", "items": { "$ref": "#/$defs/limit_hit" } }
  },
  "$defs": {
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elevated": { "type": "boolean" },
        "full_disk_access": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["home_directories", "default_keystore_passwords"],
      "additionalProperties": false,
      "properties": {
        "home_directories": { "type": "boolean" },
        "default_keystore_passwords": { "type": "boolean" },
        "excluded_paths": { "type": "array", "items": { "type": "string" } },
        "sweep_roots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "location": {
      "type": "object",
      "required": ["found_by"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "store": { "type": "string" },
        "container": { "type": "string" },
        "alias": { "type": "string" },
        "owner": { "type": "string" },
        "group": { "type": "string" },
        "mode": { "type": "string" },
        "world_readable": { "type": "boolean" },
        "group_readable": { "type": "boolean" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "modified_at": { "type": "string" },
        "found_by": { "enum": ["process", "config", "known_location", "sweep", "platform_store"] },
        "used_by": { "type": "array", "items": { "$ref": "#/$defs/usage" } }
      }
    },
    "usage": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["config", "process", "listener"] },
        "config_path": { "type": "string" },
        "root_config_path": { "type": "string" },
        "directive": { "type": "string" },
        "product": { "type": "string" },
        "context": { "type": "string" },
        "process": { "type": "string" },
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "transport": { "type": "string" }
      }
    },
    "certificate": {
      "type": "object",
      "required": ["location", "fingerprint_sha256", "is_ca", "self_signed", "trust_anchor"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "subject_dn": { "type": "string" },
        "issuer_dn": { "type": "string" },
        "serial_number": { "type": "string" },
        "fingerprint_sha256": { "type": "string" },
        "not_before": { "type": "string" },
        "not_after": { "type": "string" },
        "key_algorithm": { "type": "string" },
        "key_size": { "type": "integer", "minimum": 0 },
        "curve": { "type": "string" },
        "signature_alg": { "type": "string" },
        "is_ca": { "type": "boolean" },
        "self_signed": { "type": "boolean" },
        "dns_names": { "type": "array", "items": { "type": "string" } },
        "ip_addresses": { "type": "array", "items": { "type": "string" } },
        "public_key_sha256": { "type": "string" },
        "trust_anchor": { "type": "boolean" },
        "certificate_pem": {
          "type": "string",
          "not": { "pattern": "PRIVATE KEY" },
          "description": "The certificate itself (public). Never a key: the pattern refuses a private key label anywhere in it."
        },
        "has_private_key": { "type": "boolean" }
      }
    },
    "private_key": {
      "type": "object",
      "required": ["location", "format", "protection"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "role": { "type": "string" },
        "format": { "enum": ["pkcs1", "sec1", "pkcs8", "dsa", "openssh", "putty", "pgp", "ssh1", "platform_store"] },
        "algorithm": { "type": "string" },
        "size_bits": { "type": "integer", "minimum": 0 },
        "curve": { "type": "string" },
        "encrypted": { "type": "boolean" },
        "encryption": { "type": "string" },
        "protection": { "enum": ["file", "software", "tpm", "hsm", "enclave"] },
        "exportable": { "type": "boolean" },
        "provider": { "type": "string" },
        "provider_kind": { "enum": ["software", "tpm", "smartcard", "secure-enclave", "unknown"] },
        "public_key_sha256": { "type": "string" },
        "ssh_fingerprint": { "type": "string" },
        "unknown": { "type": "string" }
      }
    },
    "keystore": {
      "type": "object",
      "required": ["location", "type", "opened"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "type": { "enum": ["jks", "jceks", "pkcs12", "bcfks", "bks", "nss", "gnupg", "keytab", "keychain", "uber"] },
        "opened": { "enum": ["not_opened", "no_password", "default_password"] },
        "default_password": { "type": "boolean" },
        "protection": { "type": "string" },
        "entry_count": { "type": "integer", "minimum": 0 },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/keystore_entry" } },
        "unknown": { "type": "string" }
      }
    },
    "keystore_entry": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "alias": { "type": "string" },
        "kind": { "type": "string" },
        "algorithm": { "type": "string" },
        "size_bits": { "type": "integer", "minimum": 0 },
        "curve": { "type": "string" },
        "certificate_fingerprint": { "type": "string" },
        "public_key_sha256": { "type": "string" },
        "principal": { "type": "string" },
        "kvno": { "type": "integer", "minimum": 0 },
        "encryption_type": { "type": "string" }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorized_keys": { "type": "array", "items": { "$ref": "#/$defs/authorized_keys_file" } },
        "known_hosts": { "type": "array", "items": { "$ref": "#/$defs/known_hosts_file" } },
        "host_public_keys": { "type": "array", "items": { "$ref": "#/$defs/ssh_public_key" } }
      }
    },
    "authorized_keys_file": {
      "type": "object",
      "required": ["location"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "account": { "type": "string" },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/ssh_public_key" } }
      }
    },
    "ssh_public_key": {
      "type": "object",
      "required": ["algorithm", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string" },
        "size_bits": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string" },
        "restricted": { "type": "boolean" },
        "certificate_authority": { "type": "boolean" }
      }
    },
    "known_hosts_file": {
      "type": "object",
      "required": ["location"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "entries": { "type": "integer", "minimum": 0 },
        "hashed": { "type": "boolean" }
      }
    },
    "crypto_config": {
      "type": "object",
      "required": ["location", "product"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "#/$defs/location" },
        "product": { "type": "string" },
        "context": { "type": "string" },
        "protocols": { "type": "array", "items": { "type": "string" } },
        "min_protocol": { "type": "string" },
        "max_protocol": { "type": "string" },
        "cipher_string": { "type": "string" },
        "cipher_suites": { "type": "array", "items": { "type": "string" } },
        "key_exchanges": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "array", "items": { "type": "string" } },
        "macs": { "type": "array", "items": { "type": "string" } },
        "signature_algorithms": { "type": "array", "items": { "type": "string" } },
        "host_key_algorithms": { "type": "array", "items": { "type": "string" } },
        "disabled_protocols": { "type": "array", "items": { "type": "string" } },
        "disabled_algorithms": { "type": "array", "items": { "type": "string" } },
        "policy": { "type": "string" },
        "fips": { "type": "boolean" },
        "settings": { "type": "object", "additionalProperties": { "type": "string" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/config_reference" } }
      }
    },
    "config_reference": {
      "type": "object",
      "required": ["kind", "directive", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "directive": { "type": "string" },
        "path": { "type": "string" },
        "status": { "enum": ["found", "missing", "unreadable", "not_followed"] }
      }
    },
    "crypto_library": {
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "path": { "type": "string" },
        "source": { "type": "string" },
        "package": { "type": "string" },
        "fips_provider": { "type": "boolean" },
        "loaded_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volumes": { "type": "array", "items": { "$ref": "#/$defs/volume_encryption" } },
        "tpm": { "$ref": "#/$defs/tpm" },
        "secure_enclave": { "$ref": "#/$defs/secure_enclave" },
        "secure_boot": { "type": "boolean" },
        "fips_mode": { "type": "boolean" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "volume_encryption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device": { "type": "string" },
        "mount_point": { "type": "string" },
        "encrypted": { "type": "boolean" },
        "method": { "type": "string" },
        "cipher": { "type": "string" },
        "key_size_bits": { "type": "integer", "minimum": 0 },
        "protectors": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" }
      }
    },
    "secure_enclave": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "kind": { "type": "string" }
      }
    },
    "tpm": {
      "type": "object",
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "version": { "type": "string" },
        "manufacturer": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "configured_in": { "type": "string" }
      }
    },
    "step_error": {
      "type": "object",
      "required": ["step", "message"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "string" },
        "message": { "type": "string", "maxLength": 400 }
      }
    },
    "limit_hit": {
      "type": "object",
      "required": ["section", "limit"],
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string" },
        "limit": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  }
}
