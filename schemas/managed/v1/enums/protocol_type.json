    "SSH",
    "IPSec",
    "VPN",
    "Database",
    "API",
    "SMB",
    "Kerberos",
    "QUIC",
    "PPTP",
    "IKE",
    "Modbus",
    "DNP3",
    "MMS",
    "ICCP",
    "IEC62351",
    "OPC_UA",
    "EtherNet_IP",
    "BACnet",
    "BACnet_SC",
    "HART_IP",
    "S7"
  ]
}
